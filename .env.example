# Cloud Backup Configuration (optional - leave empty to disable cloud backup)
# These are needed only if you want to enable the cloud backup feature.
#
# Auth uses Google Identity Services (the ID-token flow): create an OAuth 2.0
# "Web application" client in Google Cloud Console and register the app's public
# origin as an Authorized JavaScript origin. Only the client ID is needed -- no
# client secret. The backend verifies the Google ID token and stores the
# client-side-encrypted blob via its /backup endpoint.

VITE_GOOGLE_CLIENT_ID=
VITE_CLOUD_API_ENDPOINT=
