# Stag self-hosting — copy to `.env` and fill in. `docker compose` reads this.
# Nothing here is committed: .env is gitignored.

# --- CouchDB admin (created on first boot; pick your own) ---
COUCHDB_USER=stag_admin
COUCHDB_PASSWORD=change-me-to-a-long-random-string

# --- Google OAuth (the "Sign in with Google" / cloud-backup auth) ---
# Create an OAuth 2.0 Client ID of type "Web application" in Google Cloud
# Console. Add your app's public origin (e.g. https://stag.example.com) as an
# Authorized JavaScript origin. You only need the client ID — no secret.
# This value is public (it ships in the frontend bundle and gates the backend).
GOOGLE_CLIENT_ID=000000000000-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx.apps.googleusercontent.com

# --- Public URLs ---
# Where the app is served (used as the backend CORS allow-list origin).
CORS_ORIGIN=https://stag.example.com
# Where the backend's /backup API is reachable from the browser. Baked into the
# frontend at build time, so rebuild the frontend if you change it.
VITE_CLOUD_API_ENDPOINT=https://api.example.com

# --- Optional ---
# Asset base path. Leave as / for domain-root serving. (Default /Stag/ is only
# for the GitHub Pages deploy and would 404 every asset here.)
VITE_BASE_PATH=/
# Max encrypted blob the backend accepts, in bytes (default 5 MiB). The backend
# accepts a wire body up to ~2x this (JSON escaping overhead) and 413s past it.
MAX_BLOB_BYTES=5242880
# Cloudflare named-tunnel token — only needed for `--profile tunnel`. deploy.sh
# enables the tunnel profile automatically ONLY when this is non-empty.
TUNNEL_TOKEN=

# --- Optional: restrict who may use this backend ---
# By default ANY Google account that signs in is accepted (fine for a private,
# unadvertised deployment). To lock it down, set either list (comma-separated);
# an account is admitted if it matches EITHER. Leave both empty to stay open.
# ALLOWED_SUBS: Google account `sub` IDs (stable, opaque; from a token's payload).
ALLOWED_SUBS=
# ALLOWED_EMAILS: verified Google emails (case-insensitive).
ALLOWED_EMAILS=
# Per-user write rate limit: at most WRITE_RATE_LIMIT POST /backup writes per
# WRITE_RATE_WINDOW_MS window (default 30 / 60s). Set WRITE_RATE_LIMIT=0 to
# disable. A human backing up by hand never approaches this.
WRITE_RATE_LIMIT=30
WRITE_RATE_WINDOW_MS=60000
