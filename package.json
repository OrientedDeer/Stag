{
  "name": "stag",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "homepage": "https://orienteddeer.github.io/Stag/",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "test": "vitest",
    "test:ci": "vitest run",
    "test:changed": "vitest run --changed",
    "test:ui": "vitest --ui",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "feed:example": "vite-node stagfeed/example.ts",
    "feed:check": "tsc -p stagfeed/tsconfig.json",
    "coverage": "vitest run --coverage",
    "knip": "knip",
    "knip:prod": "knip --production",
    "predeploy": "npm run build",
    "deploy": "gh-pages -d dist",
    "prepare": "husky"
  },
  "dependencies": {
    "@headlessui/react": "^2.2.9",
    "@hello-pangea/dnd": "^18.0.1",
    "@nivo/bar": "^0.99.0",
    "@nivo/icicle": "^0.99.0",
    "@nivo/line": "^0.99.0",
    "@nivo/sankey": "^0.99.0",
    "@nivo/stream": "^0.99.0",
    "@nivo/sunburst": "^0.99.0",
    "@react-pdf/renderer": "^4.3.2",
    "@rollup/rollup-linux-x64-gnu": "^4.57.1",
    "@yudiel/react-qr-scanner": "^2.5.0",
    "exceljs": "^4.4.0",
    "html2canvas": "^1.4.1",
    "jsqr": "^1.4.0",
    "pako": "^2.1.0",
    "qrcode.react": "^4.2.0",
    "react": "^19.2.3",
    "react-datasheet-grid": "^4.11.5",
    "react-dom": "^19.2.3",
    "react-router-dom": "^7.10.1",
    "react-window": "^2.2.7"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@playwright/test": "^1.57.0",
    "@tailwindcss/vite": "^4.1.17",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.1",
    "@types/node": "^24.10.1",
    "@types/pako": "^2.0.4",
    "@types/react": "^19.2.5",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.1",
    "@vitest/coverage-v8": "^4.0.16",
    "@vitest/ui": "^4.0.16",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "gh-pages": "^6.3.0",
    "globals": "^16.5.0",
    "husky": "^9.1.7",
    "jsdom": "^27.4.0",
    "knip": "^6.11.0",
    "lint-staged": "^16.2.7",
    "tailwindcss": "^4.1.17",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.46.4",
    "vite": "^7.2.4",
    "vite-node": "^6.0.0",
    "vitest": "^4.0.16"
  },
  "overrides": {
    "exceljs": {
      "uuid": "^11.1.1"
    }
  }
}
